rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Илгээмжийн зураг: нэвтэрсэн хэрэглэгч 5MB хүртэл зураг хуулж болно.
    match /shipments/{shipmentId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Брэндийн лого + танилцуулга (brochure): branding/{fileName}
    //  - read: нийтэд нээлттэй (лого/танилцуулга сайт дээр харагдана)
    //  - write: нэвтэрсэн (admin UI) — зураг (5MB) эсвэл PDF (20MB).
    match /branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType == 'application/pdf'
            && request.resource.size < 20 * 1024 * 1024)
        );
      allow delete: if request.auth != null;
    }

    // Барааны зураг: products/{companyId}/{productId}/{fileName}
    //  - read: нийтэд нээлттэй (сайт дээр харагдана)
    //  - write: нэвтэрсэн хэрэглэгч, зөвхөн зураг, шахсан webp тул 5MB-аас бага
    // Тэмдэглэл: companyId-түвшний нарийн хяналт (partner зөвхөн өөрийн companyId)
    // нь custom claims шаардана — Storage rules Firestore уншиж чадахгүй.
    match /products/{companyId}/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Хүргэлт / амжилтгүйн баталгаажуулах зураг:
    //  - delivery-proofs/{orderId}/{fileName} · failed-proofs/{orderId}/{fileName}
    //  - read: зөвхөн нэвтэрсэн (admin detail хуудас, жолооч) — public БИШ (хувийн мэдээлэл).
    //  - write: нэвтэрсэн жолооч/admin, зөвхөн зураг, шахсан webp тул 5MB-аас бага.
    match /delivery-proofs/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /failed-proofs/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
