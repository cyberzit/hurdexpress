rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Илгээмжийн зураг: нэвтэрсэн хэрэглэгч 5MB хүртэл зураг хуулж болно.
    match /shipments/{shipmentId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Брэндийн лого: branding/{fileName} — нийтэд read, нэвтэрсэн (admin UI) write.
    match /branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Барааны зураг: products/{companyId}/{productId}/{fileName}
    //  - read: нийтэд нээлттэй (сайт дээр харагдана)
    //  - write: нэвтэрсэн хэрэглэгч, зөвхөн зураг, шахсан webp тул 5MB-аас бага
    // Тэмдэглэл: companyId-түвшний нарийн хяналт (partner зөвхөн өөрийн companyId)
    // нь custom claims шаардана — Storage rules Firestore уншиж чадахгүй.
    match /products/{companyId}/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
